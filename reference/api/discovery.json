{
  "domain": "discovery",
  "baseUrl": "/api/v1",
  "auth": "Public endpoints — a customer may browse before logging in.",
  "endpoints": [
    {
      "id": "search-businesses",
      "screen": "Home / Discover, Search Results",
      "story": "C1",
      "method": "GET",
      "path": "/businesses/search",
      "description": "Lists published businesses near the given location, optionally filtered. Powers both the Home screen's default 'near me' list (called with no query/filters) and Search Results (called with them). Only businesses with status=published and visible=true are returned — see business-setup.json#publish-business.",
      "auth": "public",
      "request": {
        "lat": -1.2921,
        "lng": 36.8219,
        "query": "haircut",
        "category": "hair_salon",
        "priceMax": 2000,
        "ratingMin": 4,
        "radiusKm": 10
      },
      "response": {
        "businesses": [
          {
            "businessId": "biz_01hxyz",
            "name": "Glow Beauty Lounge",
            "categories": ["hair_salon", "nail_salon"],
            "thumbnailUrl": "https://cdn.trimyy.app/businesses/biz_01hxyz/cover.jpg",
            "address": "Kilimani, Nairobi",
            "distanceKm": 2.3,
            "startingPrice": { "amount": 500, "currency": "KES" },
            "rating": 4.7,
            "reviewCount": 128
          }
        ]
      },
      "errors": []
    },
    {
      "id": "get-business-profile",
      "screen": "Business Profile",
      "story": "C1",
      "method": "GET",
      "path": "/businesses/{businessId}/profile",
      "description": "Fetches the full customer-facing profile for a published business: photos, services grouped by the owner's own service categories, staff, reviews, and policy summaries (plain-language, derived from BusinessPolicies — see business-setup.json#set-policies).",
      "auth": "public",
      "request": null,
      "response": {
        "businessId": "biz_01hxyz",
        "name": "Glow Beauty Lounge",
        "description": "A cosy beauty lounge in the heart of Kilimani offering hair styling, coloring, and nail care in a relaxed, welcoming space.",
        "categories": ["hair_salon", "nail_salon"],
        "photos": [
          "https://cdn.trimyy.app/businesses/biz_01hxyz/photo_1.jpg",
          "https://cdn.trimyy.app/businesses/biz_01hxyz/photo_2.jpg"
        ],
        "rating": 4.7,
        "reviewCount": 128,
        "address": "Kilimani, Nairobi",
        "lat": -1.2921,
        "lng": 36.7833,
        "depositSummary": "No deposit required",
        "cancellationSummary": "Free cancellation up to 24h before, 50% fee after",
        "services": [
          {
            "serviceId": "svc_01a1",
            "categoryName": "Haircuts",
            "name": "Classic Haircut",
            "durationMinutes": 45,
            "price": { "amount": 800, "currency": "KES" }
          }
        ],
        "staff": [
          { "staffId": "staff_01a1", "name": "Jane Wanjiru", "role": "Senior Stylist", "rating": 4.8 }
        ],
        "reviews": [
          {
            "reviewId": "rev_01a1",
            "authorName": "Amina K.",
            "rating": 5,
            "text": "Amazing service, will definitely come back!",
            "createdAt": "2026-09-10T14:00:00Z"
          }
        ]
      },
      "errors": [
        { "status": 404, "code": "not_found", "message": "No published business found for this id" }
      ]
    }
  ]
}
