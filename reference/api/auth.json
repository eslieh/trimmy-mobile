{
  "domain": "auth",
  "baseUrl": "/api/v1",
  "auth": "Public unless noted. Errors use { error, message }; request validation failures are FastAPI 422 { detail: [...] }.",
  "notes": [
    "All endpoints below are live on trimmy-server and wired in src/api/auth.ts.",
    "Re-verified against local on 2026-09-25, after the backend shipped the requested gaps (logout, delete/update me, change-password, check-email, verify-reset-otp, email-scoped OTPs, resend cooldown, 409 on duplicate register)."
  ],
  "endpoints": [
    {
      "id": "check-email",
      "screen": "Welcome (single email field → Continue)",
      "method": "POST",
      "path": "/auth/check-email",
      "description": "Routes the Welcome screen: existing email → Login (prefilled), new email → sign-up.",
      "request": {
        "email": "jane@example.com"
      },
      "response": {
        "exists": true
      }
    },
    {
      "id": "register",
      "screen": "Onboarding: name (step 4 of 5)",
      "method": "POST",
      "path": "/auth/register",
      "description": "Creates the account, emails a 6-digit verification code, returns tokens for the (unverified) user.",
      "request": {
        "email": "jane@example.com",
        "password": "password123",
        "first_name": "Jane",
        "last_name": "Doe",
        "phone": "+254712345678"
      },
      "response": {
        "user": {
          "id": "uuid",
          "email": "jane@example.com",
          "first_name": "Jane",
          "last_name": "Doe",
          "phone": "+254712345678",
          "auth_type": "email",
          "verified": false,
          "created_at": "2026-09-25T11:58:25Z"
        },
        "tokens": {
          "access_token": "…",
          "refresh_token": "…",
          "token_type": "bearer"
        }
      },
      "errors": [
        {
          "status": 409,
          "code": "email_taken",
          "message": "An account with this email already exists"
        }
      ]
    },
    {
      "id": "verify-email",
      "screen": "Onboarding: verify email (step 5 of 5), also reached from Login on not_verified",
      "method": "POST",
      "path": "/auth/verify-email",
      "request": {
        "email": "jane@example.com",
        "otp": "123456"
      },
      "response": "same shape as register, verified: true",
      "errors": [
        {
          "status": 400,
          "code": "invalid_otp",
          "message": "Invalid or expired verification code"
        },
        {
          "status": 400,
          "code": "otp_attempts_exceeded",
          "message": "Too many incorrect attempts. Request a new code."
        }
      ]
    },
    {
      "id": "resend-otp",
      "screen": "Verify email / Forgot password: enter code",
      "method": "POST",
      "path": "/auth/resend-otp",
      "request": {
        "email": "jane@example.com",
        "purpose": "verification | password_reset"
      },
      "response": {
        "message": "If an account exists, a new code has been sent."
      },
      "errors": [
        {
          "status": 429,
          "code": "too_many_requests",
          "message": "Please wait before requesting another code.",
          "retry_after_seconds": 51
        }
      ]
    },
    {
      "id": "login",
      "screen": "Login",
      "method": "POST",
      "path": "/auth/login",
      "request": {
        "email": "jane@example.com",
        "password": "password123"
      },
      "response": "same shape as register",
      "errors": [
        {
          "status": 401,
          "code": "invalid_credentials",
          "message": "Invalid email or password"
        },
        {
          "status": 403,
          "code": "not_verified",
          "message": "Email not verified. A new verification code has been sent."
        }
      ]
    },
    {
      "id": "refresh",
      "method": "POST",
      "path": "/auth/refresh",
      "request": {
        "refresh_token": "…"
      },
      "response": {
        "access_token": "…",
        "refresh_token": "…",
        "token_type": "bearer"
      },
      "errors": [
        {
          "status": 401,
          "code": "invalid_refresh_token",
          "message": "Invalid refresh token"
        },
        {
          "status": 401,
          "code": "refresh_token_not_found",
          "message": "Refresh token not found"
        }
      ]
    },
    {
      "id": "logout",
      "screen": "Profile / Business menu / Staff menu: Log out",
      "auth": "any signed-in user (Bearer access token required)",
      "method": "POST",
      "path": "/auth/logout",
      "description": "Revokes the refresh token server-side. The app calls it best-effort and then clears local tokens regardless.",
      "request": {
        "refresh_token": "…"
      },
      "response": "204 No Content"
    },
    {
      "id": "me",
      "auth": "any signed-in user",
      "method": "GET",
      "path": "/auth/me",
      "errors": [
        {
          "status": 401,
          "code": "missing_token",
          "message": "Authentication required"
        },
        {
          "status": 401,
          "code": "invalid_token",
          "message": "Invalid or expired token"
        }
      ]
    },
    {
      "id": "update-me",
      "screen": "Account: Profile",
      "auth": "any signed-in user",
      "method": "PATCH",
      "path": "/auth/me",
      "request": {
        "first_name": "Jane",
        "last_name": "Doe",
        "phone": "+254712345678"
      },
      "response": "User"
    },
    {
      "id": "change-password",
      "screen": "Account: Change password",
      "auth": "any signed-in user",
      "method": "POST",
      "path": "/auth/change-password",
      "description": "Returns a fresh token pair; the app stores it. Other sessions' refresh tokens are revoked.",
      "request": {
        "current_password": "old",
        "new_password": "newpassword1"
      },
      "response": {
        "message": "Password updated",
        "tokens": {
          "access_token": "…",
          "refresh_token": "…",
          "token_type": "bearer"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_credentials",
          "message": "Current password is incorrect"
        }
      ]
    },
    {
      "id": "delete-account",
      "screen": "Account: Delete account",
      "auth": "any signed-in user",
      "method": "DELETE",
      "path": "/auth/me",
      "request": {
        "password": "password123"
      },
      "response": "204 No Content",
      "errors": [
        {
          "status": 400,
          "code": "invalid_credentials",
          "message": "Password is incorrect"
        }
      ]
    },
    {
      "id": "forgot-password",
      "screen": "Forgot password",
      "method": "POST",
      "path": "/auth/forgot-password",
      "request": {
        "email": "jane@example.com"
      },
      "response": {
        "message": "If an account exists, a reset code has been sent."
      }
    },
    {
      "id": "verify-reset-otp",
      "screen": "Forgot password: enter code",
      "method": "POST",
      "path": "/auth/verify-reset-otp",
      "description": "Checks the code before the app asks for a new password.",
      "request": {
        "email": "jane@example.com",
        "otp": "123456"
      },
      "response": {
        "valid": true
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_otp",
          "message": "Invalid or expired reset code"
        }
      ]
    },
    {
      "id": "reset-password",
      "screen": "Reset password",
      "method": "POST",
      "path": "/auth/reset-password",
      "request": {
        "email": "jane@example.com",
        "otp": "123456",
        "new_password": "newpassword1"
      },
      "response": {
        "message": "Password updated successfully"
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_otp",
          "message": "Invalid or expired reset code"
        }
      ]
    },
    {
      "id": "my-businesses",
      "screen": "Post-login routing, business/staff mode switch",
      "auth": "any signed-in user",
      "method": "GET",
      "path": "/me/businesses",
      "description": "Businesses the user owns or works at. Wrapped as authApi.listMyBusinesses(), but not yet used for mode switching: the Profile/Welcome mode buttons still seed mock businesses (see devSeed.ts).",
      "response": {
        "businesses": [
          {
            "businessId": "uuid",
            "name": "Fade Studio",
            "status": "published",
            "role": "owner"
          }
        ]
      }
    },
    {
      "id": "google-auth-url",
      "screen": "Welcome / Login: Continue with Google",
      "method": "GET",
      "path": "/auth/google/url?platform=mobile&code_challenge=<S256>",
      "description": "Google sign-in URL to open with WebBrowser.openAuthSessionAsync. The app always sends a PKCE code_challenge (base64url(sha256(code_verifier)), 43 chars) and keeps the verifier in memory. See src/utils/googleSignIn.ts.",
      "response": {
        "url": "https://accounts.google.com/o/oauth2/v2/auth?..."
      },
      "errors": [
        {
          "status": 503,
          "code": "google_not_configured",
          "message": "Google sign-in is not configured"
        },
        {
          "status": 422,
          "note": "platform missing or not web|mobile, or code_challenge malformed"
        }
      ]
    },
    {
      "id": "google-callback",
      "description": "Not called by the app. Redirects to trimmy://auth/google?code=<code>, or ?error=<code> on failure. The app treats access_denied as a quiet cancel and shows a message for email_not_verified, account_conflict and google_exchange_failed (anything else gets a generic retry message). app/auth/google.tsx absorbs the Android deep link.",
      "redirectErrors": [
        "access_denied",
        "email_not_verified",
        "account_conflict",
        "google_exchange_failed",
        "invalid_id_token"
      ]
    },
    {
      "id": "google-exchange",
      "method": "POST",
      "path": "/auth/google/exchange",
      "description": "Trade the single-use code (expires in 2 minutes) for tokens, sent with the PKCE code_verifier. Same response as login; the user is always verified, so the app goes straight to Get Started.",
      "request": {
        "code": "…",
        "code_verifier": "<43+ chars>"
      },
      "response": "same shape as register (verified: true, auth_type: 'google' for new accounts)",
      "errors": [
        {
          "status": 400,
          "code": "invalid_code",
          "message": "Invalid or expired sign-in code"
        }
      ]
    }
  ]
}
